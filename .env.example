# Copy to .env (never commit .env). docker-compose.yml reads these.
IP_SALT=            # long random string; the app refuses weak/default salts
RECEIPT_KEY=        # HMAC key shared with the speed Worker (npx wrangler secret put RECEIPT_KEY)
GOOGLE_MAPS_KEY=    # Maps JavaScript API key, HTTP-referrer restricted to your domain
GOOGLE_MAP_ID=      # vector Map ID (optional; falls back to DEMO_MAP_ID)
METRICS_TOKEN=      # optional; /api/metrics returns 404 when unset
# WEB_WORKERS=3     # uvicorn worker processes
# DEV_ASN=          # local dev only: pretend the visitor ASN (normally set by Cloudflare)
# INGEST_BBOX=      # optional bbox limit for the Ookla ingest
