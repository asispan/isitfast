[Unit]
Description=isitfast India speed server
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/isitfast-speed.env
ExecStart=/usr/bin/node /opt/isitfast-speed/server.mjs
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
